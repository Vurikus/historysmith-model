//  EFFECT
  "openConstructionEffect": {
    "effectKey": "openConstructionEffect",
    "turnDelay": "integer",
    "buildings" : [{"key": "buildingModelName", "scale" : "scaleValue"}],
    "features": [{"key": "featureModelName", "scale" : "scaleValue"}],
    "infrastructures": [{"key": "infrastructureModelName", "scale" : "scaleValue"}]
  },
  "deprecatedConstructionEffect": {
    "effectKey": "deprecatedConstructionEffect",
    "turnDelay": "integer",
    "buildings" : ["buildingModelName"],
    "features": ["featureModelName"],
    "infrastructures": ["infrastructureModelName"]
